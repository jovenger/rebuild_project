<?xml version="1.0" encoding="us-ascii"?>
<BehaviorTrees>
  <BehaviorTree name="onUpdate" is_function="0">
    <Variables>
      <Variable form="single" isPersistent="0" name="renseignement" type="information" values="" />
      <Variable form="single" isPersistent="0" name="hote" type="_wuid" values="" />
      <Variable form="single" isPersistent="0" name="etat_de_la_vie" type="_int" values="" />
      <Variable form="single" isPersistent="0" name="pouls_vu" type="_int" values="" />
      <Variable form="single" isPersistent="0" name="tours_figes" type="_int" values="" />
      <Variable form="single" isPersistent="0" name="occupe" type="_bool" values="" />
      <Variable form="single" isPersistent="0" name="tour_ms" type="_int" values="" />
      <Variable form="single" isPersistent="0" name="tour" type="_string" values="" />
      <Variable form="single" isPersistent="0" name="relance_tours" type="_int" values="" />
      <Variable form="single" isPersistent="0" name="file_tours" type="_int" values="" />
      <Variable form="single" isPersistent="0" name="relances" type="_int" values="" />
      <Variable form="single" isPersistent="0" name="relances_max" type="_int" values="" />
      <Variable form="single" isPersistent="0" name="fenetre_ms" type="_int" values="" />
      <Variable form="single" isPersistent="0" name="fenetre_max_ms" type="_int" values="" />
      <Variable form="single" isPersistent="0" name="arret_dit" type="_bool" values="" />
    </Variables>
    <Root OneTimeOnly="false" FailState="Recoverable" saveVersion="2">
      <Behavior canSkip="1">
        <While condition="true" doFail="false" propagateChildFail="false">
          <Sequence>
            <Expression expressions="$scriptorium_essai_vivant = $scriptorium_essai_vivant + 1" />
            <Expression expressions="$tour_ms = ($scriptorium_cerveau_tour_ms &gt; 0 ? $scriptorium_cerveau_tour_ms : 2000)" />
            <Expression expressions="$tour_ms = ($tour_ms &gt;= 500 ? $tour_ms : 500)" />
            <Expression expressions="$tour = concat($tour_ms, &apos;ms&apos;)" />
            <Expression expressions="$relance_tours = ($scriptorium_cerveau_relance_tours &gt; 0 ? $scriptorium_cerveau_relance_tours : 3)" />
            <Expression expressions="$file_tours = ($scriptorium_cerveau_file_tours &gt; 0 ? $scriptorium_cerveau_file_tours : 30)" />
            <Expression expressions="$relances_max = ($scriptorium_cerveau_relances_max &gt; 0 ? $scriptorium_cerveau_relances_max : 3)" />
            <Expression expressions="$fenetre_max_ms = ($scriptorium_cerveau_relances_fenetre_ms &gt; 0 ? $scriptorium_cerveau_relances_fenetre_ms : 60000)" />
            <Expression expressions="$fenetre_ms = $fenetre_ms + $tour_ms" />
            <IfCondition condition="$fenetre_ms &gt;= $fenetre_max_ms" failOnCondition="false">
              <Sequence>
                <Expression expressions="$relances = 0" />
                <Expression expressions="$fenetre_ms = 0" />
                <Expression expressions="$arret_dit = false" />
              </Sequence>
            </IfCondition>
            <IfCondition condition="$scriptorium_essai_ordre == 8" failOnCondition="false">
              <Sequence>
                <SuppressFailure>
                  <Sequence>
                    <Function_callInterrupt_attack target="$scriptorium_essai_cible" questBehavior="true" relationOverride="true" ignorePriority="true" priority="160" initiator="$enum:switch_interruptInitiator.switch" stimulusKind="$enum:crime_stimulusKind.enemy" previousReaction="$enum:crime_reactionKind.unknown" criminalFreshness="$enum:crime_criminalFreshness.unknown" defenceMode="false" escalatedFromFailedSurrender="false" freshlyAttributedCrime="false" information="$renseignement" assaultData="" nodeLabel="73110801" />
                    <Expression expressions="$scriptorium_essai_combats = $scriptorium_essai_combats + 1" />
                  </Sequence>
                </SuppressFailure>
                <Expression expressions="$scriptorium_essai_ordre = 0" />
              </Sequence>
            </IfCondition>
            <IfCondition condition="$etat_de_la_vie == 0 &amp; $relances &lt; $relances_max" failOnCondition="false">
              <SuppressFailure>
                <Sequence>
                  <Function_crime_getMrkev mrkev="$hote" nodeLabel="73110802" />
                  <AddInterrupt Behavior="&apos;scriptorium_vie_du_camp&apos;" Target="$this.id" Host="$hote" Priority="100" urgency="Default" Aliveness="Alive" Privileged="false" IgnorePriorityOnPreviousInterrupt="false" />
                  <Expression expressions="$scriptorium_essai_rejoint = $scriptorium_essai_rejoint + 1" />
                  <Expression expressions="$fenetre_ms = ($relances == 0 ? 0 : $fenetre_ms)" />
                  <Expression expressions="$relances = $relances + 1" />
                  <Expression expressions="$pouls_vu = $scriptorium_vie_pouls" />
                  <Expression expressions="$tours_figes = 0" />
                  <Expression expressions="$etat_de_la_vie = 1" />
                </Sequence>
              </SuppressFailure>
            </IfCondition>
            <IfCondition condition="$etat_de_la_vie == 0 &amp; $relances &gt;= $relances_max &amp; ~$arret_dit" failOnCondition="false">
              <Sequence>
                <Expression expressions="$scriptorium_vie_arrets = $scriptorium_vie_arrets + 1" />
                <Expression expressions="$arret_dit = true" />
                <Expression expressions="$fenetre_ms = 0" />
              </Sequence>
            </IfCondition>
            <IfCondition condition="$etat_de_la_vie &gt; 0 &amp; $scriptorium_vie_pouls == $pouls_vu" failOnCondition="false">
              <Sequence>
                <Expression expressions="$tours_figes = $tours_figes + 1" />
                <Expression expressions="$occupe = false" />
                <EntityContextCheck context="crime_interruptAttack" target="" saveVersion="2">
                  <Then canSkip="1">
                    <Expression expressions="$occupe = true" />
                  </Then>
                </EntityContextCheck>
                <EntityContextCheck context="speech_switchDialogRunning" target="" saveVersion="2">
                  <Then canSkip="1">
                    <Expression expressions="$occupe = true" />
                  </Then>
                </EntityContextCheck>
                <IfCondition condition="$etat_de_la_vie == 2 &amp; $tours_figes &gt;= $relance_tours &amp; ~$occupe" failOnCondition="false">
                  <Expression expressions="$etat_de_la_vie = 0" />
                </IfCondition>
                <IfCondition condition="$etat_de_la_vie == 1 &amp; $tours_figes &gt;= $file_tours &amp; ~$occupe" failOnCondition="false">
                  <Expression expressions="$etat_de_la_vie = 0" />
                </IfCondition>
              </Sequence>
            </IfCondition>
            <IfCondition condition="$scriptorium_vie_pouls ~= $pouls_vu" failOnCondition="false">
              <Sequence>
                <Expression expressions="$pouls_vu = $scriptorium_vie_pouls" />
                <Expression expressions="$tours_figes = 0" />
                <Expression expressions="$etat_de_la_vie = 2" />
              </Sequence>
            </IfCondition>
            <Wait timeType="GameTime" duration="$tour" doFail="false" variation="" skipInLOD="false" />
          </Sequence>
        </While>
      </Behavior>
    </Root>
    <ForestContainer />
  </BehaviorTree>
</BehaviorTrees>
